@model IEnumerable<BibliotecaMVC.Models.Libro>
@{
    ViewData["Title"] = "Listado de Libros";
}

<h1>@ViewData["Title"]</h1>
<p>Hay @Model.Count() Libros Registrados</p>
<a class="btn btn-primary" asp-action="Create">Nuevo Libro +</a>
<p></p>
<div class="row">
    @foreach (var libro in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card mb-3">
                @if (!string.IsNullOrEmpty(libro.Imagen))
                {
                    <img src="~/images/@libro.Imagen" class="card-img-top" alt="@libro.Titulo" style="height: 250px; object-fit: cover;" />
                }
                <div class="card-body">
                    <h5>@libro.Titulo</h5>
                    <h6>@libro.Autor</h6>
                    <p class="text-muted">Categoría: @libro.Categoria</p>
                    <p>Precio: $@libro.Precio.ToString("F2")</p>
                    <p>
                        @if (libro.Disponible)
                        {
                            <span class="badge bg-success">Disponible</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Prestado</span>
                        }
                    </p>
                    <a asp-action="Details" asp-route-id="@libro.ID" class="btn btn-sm btn-info">Ver</a>
                    <a asp-action="Edit" asp-route-id="@libro.ID" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@libro.ID" class="btn btn-sm btn-danger" onclick="return confirm('¿Está seguro de eliminar este libro?');">Eliminar</a>
                </div>
            </div>
        </div>
    }
</div>