@using BibliotecaMVC.Models
@{
    List<Libro> libros = ViewBag.Libros;
}
<h2>Catálogo de Libros</h2>
<table class="table table-striped">
    <thead>
    <tr>
        <th>ID</th>
        <th>Titulo</th>
        <th>Autor</th>
        <th>Categoria</th>
        <th>Precio</th>
        <th>Estado</th>
    </tr>
    </thead>
    <tbody>
        @foreach (var Libro in libros)
        {
            <tr>
                <td>@Libro.ID</td>
                <td>@Libro.Titulo</td>
                <td>@Libro.Autor</td>
                <td>@Libro.Categoria</td>
                <td>$@Libro.Precio</td>
                <td>
                    @if (@Libro.Disponible)
                    {
                        <span class="badge bg-success">Disponible</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Prestado</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>